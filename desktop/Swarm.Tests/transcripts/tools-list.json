{
  "name": "tools-list",
  "steps": [
    {
      "send": {
        "method": "tools/list",
        "params": {},
        "id": 3,
        "jsonrpc": "2.0"
      },
      "expect": {
        "response": {
          "jsonrpc": "2.0",
          "id": 3,
          "result": {
            "tools": [
              {
                "name": "task_begin",
                "description": "Begin a desktop task and obtain local user authorization; this must succeed before other tools are used. Pass policy to restrict processes/titles, enforce read-only, cap actions and duration, deny or confirm cross-app actions, and redact sensitive regions.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "targetProcess": {
                      "type": "string",
                      "description": "Optional target process name."
                    },
                    "targetTitle": {
                      "type": "string",
                      "description": "Optional target window title."
                    },
                    "policy": {
                      "type": "object",
                      "description": "Optional governance policy. Defaults are conservative: cross-app actions are denied, destructive/external actions require a confirmToken, and sensitive regions are masked.",
                      "properties": {
                        "allowedProcesses": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Process names permitted for this task."
                        },
                        "allowedTitles": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Window title fragments permitted for this task."
                        },
                        "readOnly": {
                          "type": "boolean",
                          "description": "Deny every action that changes the target."
                        },
                        "maxActions": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000,
                          "description": "Maximum executed actions."
                        },
                        "maxDurationMs": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 86400000,
                          "description": "Maximum task duration in milliseconds."
                        },
                        "allowCrossApp": {
                          "type": "boolean",
                          "description": "Allow actions on elements owned by other processes."
                        },
                        "requireConfirmFor": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Action categories that require a confirmToken: submit, delete, send, purchase, cross_app. An empty array disables confirmation."
                        },
                        "redaction": {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "enum": [
                                "mask",
                                "metadata",
                                "off"
                              ],
                              "description": "mask redacts text and pixels; metadata redacts text only; off disables redaction."
                            },
                            "categories": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              },
                              "description": "Sensitive categories to redact: password, credential, email, id, bank, phone. Empty means all."
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "outputSchema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "target": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "viewport": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "capabilities": {
                      "type": "object",
