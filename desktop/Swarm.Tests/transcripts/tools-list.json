              {
                "name": "click",
                "description": "Click in the authorized task. elementId takes precedence over coordinates; x and y are window-client CSS coordinates returned by observe. If the target ignores window messages (see observe.capabilities), call focus first. Set observe to refresh the view in the same call.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Task token."
                    },
                    "elementId": {
                      "type": "string",
                      "description": "Preferred observed element id."
                    },
                    "x": {
                      "type": "number",
                      "description": "Window-client CSS x coordinate."
                    },
                    "y": {
                      "type": "number",
                      "description": "Window-client CSS y coordinate."
                    },
                    "label": {
                      "type": "string",
                      "description": "Optional click label."
                    },
                    "verify": {
                      "type": "string",
                      "description": "Set pixels to confirm the click with a stable before/after pixel diff of the element or click region."
                    },
                    "observe": {
                      "type": "boolean",
                      "description": "Return a fresh observation after the click."
                    },
                    "confirmToken": {
                      "type": "string",
                      "description": "One-time token returned by needs_confirmation for this exact action."
                    }
