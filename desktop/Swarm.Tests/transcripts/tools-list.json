                    },
                    "frameAgeMs": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "warning": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "annotations": {
                  "readOnlyHint": true,
                  "destructiveHint": false,
                  "idempotentHint": true,
                  "openWorldHint": true
                }
