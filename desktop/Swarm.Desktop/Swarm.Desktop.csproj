<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <PackageReference Include="TesseractOCR" Version="5.5.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <ProjectReference Include="..\Swarm.Core\Swarm.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\renderer\**\*" Link="renderer\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\swarm-rebuild\swarm.js" Link="renderer\swarm.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="..\renderer\**\*.test.mjs" />
  </ItemGroup>
</Project>
