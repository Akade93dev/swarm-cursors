{
  "name": "progress-notifications",
  "transport": {
    "progress": [
      {"value": 0.2, "message": "capture"},
      {"value": 0.55, "message": "uia"},
      {"value": 0.95, "message": "screenshot"}
    ],
    "result": {"token":"t1"}
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "p1",
        "method": "tools/call",
        "params": {
          "name": "observe",
          "arguments": {"token":"t1"},
          "_meta": {"progressToken":"tok-1"}
        }
      },
      "expect": {
        "notifications": [
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":"tok-1","progress":0.2,"total":1,"message":"capture"}},
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":"tok-1","progress":0.55,"total":1,"message":"uia"}},
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":"tok-1","progress":0.95,"total":1,"message":"screenshot"}}
        ],
        "response": {
          "jsonrpc": "2.0",
          "id": "p1",
          "result": {
            "structuredContent": {"token":"t1"},
            "content": [{"type":"text","text":"{\"token\":\"t1\"}"}]
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "p2",
        "method": "tools/call",
        "params": {
          "name": "click",
          "arguments": {"token":"t1","x":10,"y":20},
          "_meta": {"progressToken":42}
        }
      },
      "expect": {
        "notifications": [
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":42,"progress":0.2,"total":1,"message":"capture"}},
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":42,"progress":0.55,"total":1,"message":"uia"}},
          {"jsonrpc":"2.0","method":"notifications/progress","params":{"progressToken":42,"progress":0.95,"total":1,"message":"screenshot"}}
        ],
        "response": {
          "jsonrpc": "2.0",
          "id": "p2",
          "result": {
            "structuredContent": {"token":"t1"},
            "content": [{"type":"text","text":"{\"token\":\"t1\"}"}]
          }
        }
      }
    }
  ]
}
