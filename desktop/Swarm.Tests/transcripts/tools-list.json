                "annotations": {
                  "readOnlyHint": false,
                  "destructiveHint": false,
                  "idempotentHint": false,
                  "openWorldHint": true
                }
              },
              {
                "name": "observe",
                "description": "Observe the authorized window and return elements, window-client CSS geometry, occlusion state, and target capabilities. If capabilities.messageReliable is false (Chromium/Electron), actions on a non-foreground window return needs_foreground with reason app_ignores_message; call focus first. Set includeScreenshot to receive a PNG.",
                "inputSchema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Task token returned by task_begin."
                    },
                    "includeScreenshot": {
                      "type": "boolean",
                      "description": "Return a PNG screenshot scaled to at most 1600 px."
