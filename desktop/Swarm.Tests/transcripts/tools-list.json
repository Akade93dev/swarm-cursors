                      "type": "object",
                      "additionalProperties": true
                    },
                    "generation": {
                      "type": "integer"
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "redactions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
